# Database driver: 'postgres' (default, for Vercel/Neon) or 'sqlite' (local dev)
DB_TYPE=postgres

# Postgres connection string (from Neon dashboard or any PostgreSQL provider)
# On Vercel: automatically set when you link a Neon database via Storage tab
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# SQLite database file (only used when DB_TYPE=sqlite)
# Defaults to flashcards.db in the project root
# DB_PATH=./flashcards.db

# Initial admin account — seeded automatically on first startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# Restrict CORS to your Vercel domain in production
# Leave unset for local development (allows all origins)
CORS_ORIGIN=https://your-app.vercel.app

# Server port (default: 3001)
PORT=3001

# Set to "production" on Vercel (enables SSL for Postgres)
NODE_ENV=production
