# PostgreSQL connection string (from Neon dashboard or any PostgreSQL provider)
# On Vercel: automatically set when you link a Neon database via Storage tab
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Initial admin account — seeded automatically on first startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# Restrict CORS to your Vercel domain in production
# Leave unset for local development (allows all origins)
CORS_ORIGIN=https://your-app.vercel.app

# Set to "production" on Vercel (enables SSL for database)
NODE_ENV=production
