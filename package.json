    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "better-sqlite3": "^11.9.1",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "country-flag-icons": "^1.6.16",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "pg": "^8.13.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  }
